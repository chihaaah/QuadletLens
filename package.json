{
  "name": "quadletlens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @quadletlens/web",
    "test": "vitest run",
    "test:quadlet": "npm run build --workspace @quadletlens/core && node --test tests/integration/quadlet.integration.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/web",
    "build": "npm run typecheck && npm run build --workspace @quadletlens/core && npm run build --workspace @quadletlens/web"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
